# PostgreSQL / Supabase
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Redis host and port are overridden by compose.yaml for the backend container.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

SECRET_KEY=replace-with-a-long-random-secret

# Public origin and published frontend port.
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false

PARSERDOC_URL=https://parserdoc.srubai.ru
PARSERDOC_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=20971520

YANDEX_DISK_OAUTH_TOKEN=
YANDEX_DISK_API_URL=https://cloud-api.yandex.net
YANDEX_DISK_TIMEOUT_SECONDS=120
